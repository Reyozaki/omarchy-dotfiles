#!/usr/bin/env bash

# Configurations
LOCAL_DIR="$HOME/Storage/proton-backup"
REMOTE="gdrive:backup"

# Ensure local directory exists
if [ ! -d "$LOCAL_DIR" ]; then
    echo "Local directory '$LOCAL_DIR' does not exist."
    exit 1
fi

echo "🔌 Starting sync: backup to Google Drive..."
rclone sync "$LOCAL_DIR" "$REMOTE" --progress

if [ $? -eq 0 ]; then
    echo "✅ Sync completed successfully."
else
    echo "❌ Sync failed!"
fi
