#!/usr/bin/env bash
set -euo pipefail

# Configuration
LOCAL_DIR="$HOME/Storage/proton-backup/"
REMOTE_DIR="remote:backup"

# Temporary mount location for Proton Drive
MOUNT_DIR="$HOME/Storage/protondrive"

# Argument check
if [[ $# -ne 1 ]]; then
    echo "Usage: proton-sync <2fa_code>"
    exit 1
fi

TWOFA="$1"

# Ensure mount directory exists
mkdir -p "$MOUNT_DIR"

# If a stale mount exists, clear it
if mount | grep -q "$MOUNT_DIR"; then
    echo "⚠️  Existing mount detected. Cleaning it up..."
    fusermount -uz "$MOUNT_DIR" || true
fi

# Mount Proton Drive
echo "🔌 Mounting Proton Drive..."
rclone mount "$REMOTE_DIR" "$MOUNT_DIR" \
    --vfs-cache-mode writes \
    --protondrive-2fa="$TWOFA" \
    --daemon

# Wait briefly so the mount becomes active
sleep 2

if ! mount | grep -q "$MOUNT_DIR"; then
    echo "❌ Failed to mount Proton Drive."
    exit 1
fi

echo "✅ Mounted. Starting sync..."

# Perform the sync
rclone sync "$LOCAL_DIR" "$MOUNT_DIR" --progress

echo "✅ Sync completed."

# Unmount
echo "🔌 Unmounting..."
fusermount -uz "$MOUNT_DIR" || true

echo "✨ Finished successfully."
