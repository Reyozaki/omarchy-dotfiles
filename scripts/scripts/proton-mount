#!/usr/bin/env bash
set -euo pipefail

# Configuration
MOUNT_DIR="$HOME/Storage/protondrive"
REMOTE_DIR="remote:backup"

# Helper: unmount cleanly
do_unmount() {
    echo "🔌 Unmounting Proton Drive..."

    if mount | grep -q "$MOUNT_DIR"; then
        fusermount -uz "$MOUNT_DIR" || true
        echo "✅ Unmounted."
    else
        echo "ℹ️  Nothing is mounted at $MOUNT_DIR."
    fi

    # kill any leftover rclone mount processes
    PIDS=$(pgrep -f "rclone mount $REMOTE_DIR")
    if [[ -n "${PIDS:-}" ]]; then
        echo "⚠️  Killing stale rclone mount processes..."
        kill $PIDS || true
    fi

    exit 0
}

# Command: proton-mount unmount
if [[ $# -eq 1 && "$1" == "unmount" ]]; then
    do_unmount
fi

# Normal mount (needs 2FA)
if [[ $# -ne 1 ]]; then
    echo "Usage:"
    echo "  proton-mount <2fa_code>"
    echo "  proton-mount unmount"
    exit 1
fi

TWOFA="$1"

# Ensure mount directory exists
mkdir -p "$MOUNT_DIR"

# If something is already mounted, clear it first
if mount | grep -q "$MOUNT_DIR"; then
    echo "⚠️  Existing mount detected. Cleaning it up..."
    do_unmount
fi

echo "🔌 Mounting Proton Drive to $MOUNT_DIR..."

rclone mount "$REMOTE_DIR" "$MOUNT_DIR" \
    --vfs-cache-mode writes \
    --protondrive-2fa="$TWOFA"

# If rclone exits, the mount dies, so add a note:
echo "⚠️  Mount session ended. If this was unintended, check for internet/timeout issues."
